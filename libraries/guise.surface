# guise-ui 1.6.0 — the component surface Tailor catalogues against.
#
# Regenerate with `cargo run -p tailor-surface`, which reads the version
# pinned in Cargo.lock. Do that in the same commit as a version bump: the
# `version` line below is checked against the lockfile, so a stale file
# fails the tests rather than going unnoticed.
#
# component <Type> <file>            a RenderOnce builder or a Render entity
# preset    <id> <constructor> <scheme>

version 1.6.0

